# Ụlọ Ọma Environment Configuration
# Copy this file to .env.local for local testing, or set in Vercel / hosting environment variables.
# NEVER commit .env or .env.local containing real secrets to GitHub!

# -------------------------------------------------------------
# Supabase Configuration
# -------------------------------------------------------------
# Found in your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------------
# Flutterwave Payment Gateway Configuration
# -------------------------------------------------------------
# Found in your Flutterwave dashboard -> Settings -> API Keys & Webhooks
# Public Key (Safe for frontend checkout initialization)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Secret Key (USED ONLY IN SERVERLESS /api/payments/verify - NEVER EXPOSE TO CLIENT)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Encryption Key
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST_xxxxxxxxxxxx

# Webhook Secret Hash (Set in Flutterwave dashboard webhook settings)
FLUTTERWAVE_WEBHOOK_HASH=your_custom_webhook_secret_hash

# -------------------------------------------------------------
# Application Settings
# -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://ulooma01.vercel.app
APP_ENVIRONMENT=production
